# MarketEdge AI (lite) — local development with docker compose. Production: see docs/DEPLOYMENT.md (Vercel + Neon + GitHub Actions).
POSTGRES_PASSWORD=change-me-local-password
SECRET_KEY=change-me-to-64-random-hex-characters-please-0123456789abcdef
# Fernet key protecting stored provider keys (Upstox token) and 2FA secrets:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# First admin (created on start-up / by the daily job if missing)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Adm1n!Password

# Markets: NSE + NIFTY options and CRYPTO
MARKETS_ENABLED=NSE,CRYPTO
# sample = synthetic DEMO_ data (development). Real data:
#   MARKET_DATA_PROVIDER=upstox OPTIONS_DATA_PROVIDER=upstox  (analytics token in Admin → Providers)
#   BENCHMARK_SYMBOL=NIFTY50 VIX_SYMBOL=INDIAVIX OPTIONS_UNDERLYING=NIFTY50 OPTIONS_DISPLAY_NAME="NIFTY 50"
#   CRYPTO_DATA_PROVIDER=binance BENCHMARK_CRYPTO=BTCUSDT   (free public data, no key)
MARKET_DATA_PROVIDER=sample
OPTIONS_DATA_PROVIDER=sample
CRYPTO_DATA_PROVIDER=sample
UPSTOX_UNIVERSE_SIZE=300
UPSTOX_HISTORY_DAYS=1460
BINANCE_UNIVERSE_SIZE=40
BINANCE_EXCLUDE=

# Jobs: inline (run in the request; local) | github (dispatch .github/workflows/daily.yml; Vercel)
JOB_RUNNER=inline
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=

ALLOW_REGISTRATION=true
DEFAULT_MARKET=
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Notifications (secrets go in Admin → Providers: smtp/PASSWORD, telegram/BOT_TOKEN)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
