# ---- copy to .env and fill in. Never commit .env ----
ENVIRONMENT=development
POSTGRES_USER=marketedge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marketedge

# 32+ random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key (required in production):  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# Data providers: sample (SYNTHETIC, dev only) | csv (your licensed files in the marketdata volume)
MARKET_DATA_PROVIDER=sample
FUNDAMENTALS_PROVIDER=none
# When using real data set these to your instruments.csv symbols, e.g. NIFTY50 / INDIAVIX
BENCHMARK_SYMBOL=DEMO_NIFTY50
VIX_SYMBOL=DEMO_INDIAVIX

# Created/promoted on API startup if set
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Options (Phase 2): sample (SYNTHETIC) | csv (licensed chain snapshots under options/<UNDERLYING>/)
OPTIONS_DATA_PROVIDER=sample
OPTIONS_UNDERLYING=DEMO_NIFTY50
OPTIONS_DISPLAY_NAME=DEMO NIFTY
RISK_FREE_RATE=0.065
DIVIDEND_YIELD=0.012

# Peers allowed to set X-Forwarded-For (used for per-client rate limiting). Default covers loopback +
# private ranges for local Docker. In production narrow this to your load balancer / frontend subnet.
# TRUSTED_PROXIES=10.0.1.0/24

# Multi-market (Phase 4). Providers: sample (SYNTHETIC) | binance (crypto, public market data) | twelvedata (global/FX, API key) | csv
MARKETS_ENABLED=NSE,CRYPTO,US,EUROPE,ASIA,FX
CRYPTO_DATA_PROVIDER=sample
GLOBAL_DATA_PROVIDER=sample
FX_DATA_PROVIDER=sample
# With real providers point benchmarks at real symbols, e.g. BENCHMARK_CRYPTO=BTCUSDT, BENCHMARK_US=SPY (from your universe file)
BENCHMARK_CRYPTO=DEMO_BTC
BENCHMARK_US=DEMO_US500
BENCHMARK_EUROPE=DEMO_EU600
BENCHMARK_ASIA=DEMO_ASIA50
BENCHMARK_FX=DEMO_DXY
# Binance: use a host you are permitted to access from your jurisdiction
BINANCE_SPOT_URL=https://data-api.binance.vision
BINANCE_FUTURES_URL=https://fapi.binance.com
BINANCE_UNIVERSE_SIZE=40
# Twelve Data: prefer storing the key via Admin → Providers (encrypted); env fallback:
# TWELVEDATA_API_KEY=
TWELVEDATA_RATE_PER_MIN=8

# News, calendars, AI analyst (Phase 5)
NEWS_PROVIDER=sample          # sample | finnhub | none
CALENDAR_PROVIDER=sample      # sample | finnhub | csv | none
# Finnhub key: prefer Admin → Providers (finnhub / API_KEY, stored encrypted); env fallback:
# FINNHUB_API_KEY=
# AI analyst: prefer Admin → Providers (anthropic / API_KEY); env fallback. Without a key the analyst gives rule-based explanations.
# ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5-5
ANALYST_EFFORT=medium
ANALYST_PER_HOUR=20

# Notifications (Phase 7). Secrets (SMTP password, Telegram bot token, VAPID private key, WhatsApp token) are best
# stored via Admin → Providers: smtp/PASSWORD, telegram/BOT_TOKEN, webpush/VAPID_PRIVATE_KEY, whatsapp/ACCESS_TOKEN.
PUBLIC_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
TELEGRAM_BOT_USERNAME=
# set a random secret and register the webhook https://<api>/api/v1/notifications/telegram/webhook with Telegram;
# leave empty to use the built-in poller instead
TELEGRAM_WEBHOOK_SECRET=
# generate with: npx web-push generate-vapid-keys  (public key here, private key via Admin → Providers)
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# WhatsApp Business Cloud API: an approved template with two body parameters (title, message) and user opt-in are required
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=

# Operations (Phase 8)
LOG_FORMAT=text              # json in production (one JSON object per line, with request_id)
LOG_LEVEL=INFO
METRICS_TOKEN=               # bearer token for /metrics; when unset, /metrics is disabled in production
SENTRY_DSN=                  # optional error tracking
SCAN_WORKERS=4               # per-symbol processes in the scans worker (Linux; solo pool)
BACKTEST_WORKERS=4
WEB_CONCURRENCY=2            # uvicorn worker processes in the API container
PREWARM_TOP_N=40             # analysis/candles cached for the top symbols right after each scan
AUDIT_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=90
# Production refuses sample (DEMO_) providers; set true only for a clearly labelled demo deployment
ALLOW_SAMPLE_IN_PRODUCTION=false
# Any secret can be supplied from a file instead: SECRET_KEY_FILE=/run/secrets/secret_key (Docker/K8s secrets)

# Crypto on real data (free, public Binance endpoints, no key): CRYPTO_DATA_PROVIDER=binance, BENCHMARK_CRYPTO=BTCUSDT.
# Universe = top BINANCE_UNIVERSE_SIZE USDT pairs by 24h volume; stablecoins (by price behaviour), leveraged tokens and
# gold-backed tokens are excluded automatically. BINANCE_EXCLUDE adds base assets to skip (comma-separated).
BINANCE_UNIVERSE_SIZE=40
BINANCE_EXCLUDE=
# Market the UI opens on. Unset → the first enabled market on real (non-sample) data, else NSE.
DEFAULT_MARKET=

# India on real data via Angel One SmartAPI (free with an Angel One account; personal use).
# Credentials go in Admin → Providers (encrypted): angelone / API_KEY, CLIENT_CODE, MPIN, TOTP_SECRET.
# Then: MARKET_DATA_PROVIDER=angelone  OPTIONS_DATA_PROVIDER=angelone
#       BENCHMARK_SYMBOL=NIFTY50  VIX_SYMBOL=INDIAVIX  OPTIONS_UNDERLYING=NIFTY50
ANGEL_HISTORY_DAYS=2200
ANGEL_UNIVERSE_SIZE=500

# India on real data via Upstox (free with an Upstox account; personal use).
# 1) Upstox developer apps → create app, Redirect URL = UPSTOX_REDIRECT_URI (exactly)
# 2) Admin → Providers: upstox / API_KEY, upstox / API_SECRET  3) click "Connect Upstox" (daily; tokens end 03:30 IST)
# Then: MARKET_DATA_PROVIDER=upstox  OPTIONS_DATA_PROVIDER=upstox  BENCHMARK_SYMBOL=NIFTY50  VIX_SYMBOL=INDIAVIX  OPTIONS_UNDERLYING=NIFTY50
UPSTOX_REDIRECT_URI=http://localhost:3000/api/v1/upstox/callback
UPSTOX_HISTORY_DAYS=2200

# Simple mode. Features listed here are switched off (hidden in the UI, API not served, jobs not scheduled);
# nothing is deleted — remove a name to bring it back. Names: news,calendar,analyst,ml,analytics,backtest,strategies,options
FEATURES_DISABLED=
# Single-user installs: close public sign-up (existing accounts keep working)
ALLOW_REGISTRATION=true
