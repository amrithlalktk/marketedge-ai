{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**,alembic/**,**/*.db,.venv/**,.pytest_cache/**,.ruff_cache/**,Dockerfile}"
    }
  }
}
